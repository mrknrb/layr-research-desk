{
  "repository": "https://github.com/mrknrb/layr-research-desk",
  "id": "research-desk",
  "name": "Research desk",
  "version": "0.3.3",
  "description": "A pack for lab work: experiments and their explained methods big in the middle, quick charts, notes and the web on the side, and a desk for writing up.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "biotech",
  "kind": "app",
  "dependencies": {
    "research": ">=0.3.0, <1.0.0",
    "notes": ">=0.1.0, <1.0.0",
    "browser": ">=0.1.0, <1.0.0"
  },
  "layout": {
    "v": 1,
    "root": {
      "type": "split",
      "dir": "row",
      "sizes": [
        0.66,
        0.34
      ],
      "children": [
        {
          "type": "tabs",
          "tabs": [
            {
              "plugin": "research",
              "panel": "experiments"
            },
            {
              "plugin": "research",
              "panel": "main"
            }
          ]
        },
        {
          "type": "split",
          "dir": "column",
          "sizes": [
            0.6,
            0.4
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "notes",
                  "panel": "main",
                  "title": "Lab notes"
                }
              ]
            },
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "browser",
                  "panel": "start"
                }
              ]
            }
          ]
        }
      ]
    },
    "floating": []
  },
  "sessions": [
    {
      "id": "analyse",
      "name": "Analyse data",
      "icon": "science",
      "description": "Experiments and quick analyses big in the middle; lab notes and the web on the side.",
      "layout": {
        "v": 1,
        "root": {
          "type": "split",
          "dir": "row",
          "sizes": [
            0.66,
            0.34
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "research",
                  "panel": "experiments"
                },
                {
                  "plugin": "research",
                  "panel": "main"
                }
              ]
            },
            {
              "type": "split",
              "dir": "column",
              "sizes": [
                0.6,
                0.4
              ],
              "children": [
                {
                  "type": "tabs",
                  "tabs": [
                    {
                      "plugin": "notes",
                      "panel": "main",
                      "title": "Lab notes"
                    }
                  ]
                },
                {
                  "type": "tabs",
                  "tabs": [
                    {
                      "plugin": "browser",
                      "panel": "start"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "floating": []
      }
    },
    {
      "id": "write-up",
      "name": "Write up",
      "icon": "edit_note",
      "description": "A write-up in Notes next to the experiments it reports.",
      "layout": {
        "v": 1,
        "root": {
          "type": "split",
          "dir": "row",
          "sizes": [
            0.55,
            0.45
          ],
          "children": [
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "notes",
                  "panel": "main",
                  "title": "Write-up"
                }
              ]
            },
            {
              "type": "tabs",
              "tabs": [
                {
                  "plugin": "research",
                  "panel": "experiments"
                },
                {
                  "plugin": "research",
                  "panel": "main"
                }
              ]
            }
          ]
        },
        "floating": []
      }
    }
  ]
}
